{
  "name": "nova_a",
  "private": true,
  "version": "26.47.0",
  "homepage": "https://github.com/Stevenzhang543/Nova_A/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Stevenzhang543/Nova_A.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": "22.22.2",
    "pnpm": "10.30.0"
  },
  "scripts": {
    "dev": "pnpm build:wasm:dev && vite",
    "build": "pnpm build:wasm && vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "node scripts/run-tauri.mjs",
    "build:wasm": "wasm-pack build crates/nova_wasm --target web --out-dir ../../nova_core/pkg --out-name nova_core --release",
    "build:wasm:dev": "wasm-pack build crates/nova_wasm --target web --out-dir ../../nova_core/pkg --out-name nova_core --dev",
    "check": "vue-tsc --noEmit && tsc --project tsconfig.node.json --noEmit",
    "check:config": "tsc --project tsconfig.node.json --noEmit",
    "test:core": "cargo test --workspace --all-targets",
    "test:scripts:headless": "cargo run -p nova_script --example nova_script_test --",
    "generate:components": "node scripts/generate-component-primitives.mjs && node scripts/generate-component-enums.mjs",
    "generate:rhai-signatures": "node scripts/generate-rhai-api-signatures.mjs",
    "api:docs": "node scripts/generate-script-api-docs.mjs",
    "script:lsp": "node scripts/nova-rhai-language-server.mjs",
    "nova": "node scripts/nova-cli.mjs",
    "validate": "node scripts/nova-cli.mjs validate",
    "import:headless": "node scripts/nova-cli.mjs import",
    "test:headless": "node scripts/nova-cli.mjs test",
    "export": "node scripts/nova-cli.mjs export",
    "package:validate": "node scripts/nova-cli.mjs package",
    "version:machine": "node scripts/nova-cli.mjs version --jsonl",
    "package:publisher": "node scripts/nova-package-publisher.mjs",
    "references": "node scripts/export-reference-projects.mjs",
    "check:repository": "node scripts/generate-component-primitives.mjs --check && node scripts/generate-component-enums.mjs --check && node scripts/audit-manual.mjs && node scripts/verify-template-catalog.mjs && node scripts/audit-repository-hygiene.mjs && node scripts/audit-typography.mjs",
    "audit:manual": "node scripts/audit-manual.mjs",
    "verify:templates": "node scripts/verify-template-catalog.mjs",
    "audit:repository": "node scripts/audit-repository-hygiene.mjs",
    "audit:typography": "node scripts/audit-typography.mjs",
    "build:engine:profile": "node scripts/build-engine-profile.mjs",
    "audit:engine:boundaries": "node scripts/audit-engine-boundaries.mjs",
    "verify:engine:scheduler": "node scripts/verify-engine-scheduler.mjs",
    "verify:engine:assets": "node scripts/verify-engine-asset-admission.mjs",
    "verify:engine:platform-host": "node scripts/verify-engine-platform-host.mjs",
    "release": "scripts\\release.cmd",
    "release:package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-release.ps1"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-opener": "2.5.3",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "22.20.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "source-map-js": "1.2.1",
    "typescript": "~5.6.2",
    "vite": "^6.4.3",
    "vue-tsc": "^2.1.10"
  }
}
