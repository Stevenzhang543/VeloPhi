{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VeloPhi",
  "version": "26.56.0",
  "identifier": "app.velophi.physics",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5178",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VeloΦ 26.56",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680,
        "center": true,
        "maximized": false,
        "visible": false,
        "backgroundColor": "#0d0f14",
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; font-src 'self' data:; worker-src 'self' blob:",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "VeloPhi",
    "shortDescription": "可验证的力学仿真与教学引擎",
    "longDescription": "VeloPhi（VeloΦ）：面向物理专业学生与物理教师的力学仿真与教学引擎。搭建场景、精确仿真、随时暂停读数，并自动匹配公式与仿真结果对照。",
    "copyright": "© 2026 VeloPhi",
    "category": "Education",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}
