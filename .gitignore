# Nova_A keeps code, the resources the build needs and the documentation in Git.
# Everything generated, cached, packaged or private stays out (26.45).

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies and package-manager stores (reusable, never committed)
node_modules
.pnpm-store/

# Build outputs and caches (reusable caches stay on disk)
dist
dist-ssr
.vite/
.cache/
.turbo/
*.tsbuildinfo
nova_core/target/
nova_core/pkg/
/target/
/src-tauri/target/
/src-tauri/gen/
.nova-build-cache/

# Test, audit and release output
coverage/
playwright-report/
test-results/
release-audits/
/reports/
/releases/
stage*/

# Game exports written into the repository folder or any folder inside it (Build Settings output)
/*.exe
*.exe
/build-info.json
build-info.json
nova-build-*.json
nova-content-manifest.json
nova-dependency-report.json
nova-deployment-manifest.json
nova-patch-manifest.json
nova-platform-config.json
nova-sbom.cdx.json
symbols/nova-symbol-map.json
game.nova-pak
/nova-*.json
/symbols/

# Temporary files
*.tmp
*.temp
*.local
*.tgz
__pycache__/
/_to_delete/

# Local configuration and credentials. Keep the documented example.
.env
.env.*
!.env.example

# Editor directories and files
.vscode
.idea
.VSCodeCounter/
.DS_Store
Thumbs.db
Desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Private notes
/instructions.txt

# User-provided engine reference; never part of Nova_A source packages.
/godot-master

# Workspace agent-tooling skills; third-party content, not Nova_A source.
/.dsh/
